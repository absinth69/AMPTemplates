Meta.ID=battlefield2
Meta.Name=Battlefield 2
Meta.Description=Battlefield 2 dedicated server (1.50) with BF2Hub support
Meta.Author=ClassicFraggers community draft
Meta.Version=1.0.0
Meta.OS=Linux
Meta.Arch=x86_64
Meta.URL=https://www.bf2hub.com/
Meta.ConfigManifest=battlefield2config.json
Meta.MetaConfigManifest=battlefield2metaconfig.json
Meta.ConfigVersion=1
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/absinth69/AMPTemplates/main/images/battlefield2-banner.jpg
Meta.EndpointURIFormat=steam://connect/{0}
Meta.MinAMPVersion=2.4.2.0

App.ExecutableLinux=start.sh
App.WorkingDir=.
App.LinuxCommandLineArgs=
App.CommandLineArgs=
App.ApplicationIPBinding=0.0.0.0
App.RapidStartup=True

App.Ports=[{"Protocol":1,"Port":16567,"Offset":0,"Range":1,"Ref":"GamePort","Name":"Game Port"},{"Protocol":1,"Port":29900,"Offset":0,"Range":1,"Ref":"GameSpyPort","Name":"GameSpy Port"},{"Protocol":0,"Port":4711,"Offset":0,"Range":1,"Ref":"RCONPort","Name":"RCON Port"}]
App.PrimaryApplicationPortRef=GamePort

App.TailLogFilePath=mods/bf2/settings/server.log
App.UpdateSources=[]
