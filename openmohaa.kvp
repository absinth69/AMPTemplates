Meta.DisplayName=OpenMoHAA (Allied Assault + Expansions) [Development]
Meta.Description=GUI-configurable OpenMoHAA dedicated server. User-provided assets and engine required in this development build.
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=Unknown
Meta.AppConfigId=5de463bf-15c9-4cff-8195-fa2b413cdf80
Meta.Author=ClassicFraggers community draft
Meta.URL=https://www.openmohaa.org/
Meta.DisplayImageSource=none:
Meta.ConfigManifest=openmohaaconfig.json
Meta.MetaConfigManifest=openmohaametaconfig.json
Meta.ConfigRoot=openmohaa.kvp
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.AppIsMultiIPAware=True
Meta.ExtraContainerPackages=[]
Meta.MinAMPVersion=2.8.0.8
Meta.ConfigVersion=1
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.Prerequisites=[]
Meta.ImportableExtensions=[]
App.DisplayName=OpenMoHAA
App.RootDir=./openmohaa/
App.BaseDirectory=./openmohaa/server/
App.ExecutableLinux=server/omohaaded
App.WorkingDir=server
App.ExecutableWin=
App.CommandLineArgs=+set fs_basepath . +set fs_homepath ./home +set com_target_game {{Game}} +set net_ip {{$ApplicationIPBinding}} +set net_port {{$ServerPort}} +exec amp-server.cfg {{$FormattedArgs}} +map {{StartupMap}}
App.CommandLineParameterFormat=+{1}
App.AppSettings={"Game":"0","StartupMap":"dm/mohdm1","sv_hostname":"OpenMoHAA | AMP","sv_maxclients":"16","sv_keywords":"OpenMoHAA","g_password":"","rconpassword":"","sv_privateClients":"0","sv_privatePassword":"","timelimit":"20","fraglimit":"0","roundlimit":"0","g_healthdrop":"1","g_forceteamspectate":"1","g_teamkillwarn":"3","g_teamkillkick":"5","g_teamswitchdelay":"15","g_allowjointime":"30","g_inactivespectate":"60","g_inactivekick":"900","sv_invulnerabletime":"0","sv_dmspeedmult":"1.1","sv_sprintmult":"1.2","sv_sprinttime":"5","sv_team_spawn_interval":"0","sv_floodprotect":"1","sv_gamespy":"1","sv_minPing":"0","sv_maxPing":"0","sv_minRate":"0","sv_maxRate":"0","dmflags":"0","sv_maplist":"dm/mohdm1 dm/mohdm2 dm/mohdm3 dm/mohdm4","g_gametype":"1","g_teamdamage":"0","sv_sprinton":"0","CustomCommand01":"","CustomCommand02":"","CustomCommand03":"","CustomCommand04":"","CustomCommand05":"","CustomCommand06":"","CustomCommand07":"","CustomCommand08":"","CustomCommand09":"","CustomCommand10":"","CustomCommand11":"","CustomCommand12":"","CustomCommand13":"","CustomCommand14":"","CustomCommand15":"","CustomCommand16":""}
App.EnvironmentVariables={}
App.ExitMethod=String
App.ExitString=quit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.AdminMethod=STDIO
App.ApplicationIPBinding=0.0.0.0
App.SupportsIPv6=False
App.Ports=@IncludeJson[openmohaaports.json]
App.PrimaryApplicationPortRef=ServerPort
App.AdminPortRef=ServerPort
App.MaxUsers=16
App.UpdateSources=[]
App.SteamForceLoginPrompt=False
App.RapidStartup=True
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.AppReadyRegex=
Console.UserJoinRegex=
Console.UserLeaveRegex=
Console.UserChatRegex=
